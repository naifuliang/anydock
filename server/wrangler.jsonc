{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anydock",
  "account_id": "7f1052dd81e37b78c2c47fdaa53533a9",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Better Auth needs AsyncLocalStorage.
  "compatibility_flags": ["nodejs_compat"],
  // Static files (install.sh, the CLI bundle) are served before the Worker runs.
  "assets": { "directory": "./public" },
  "vars": {
    "BETTER_AUTH_URL": "https://anydock.ai",
    "SYSTEM_EMAIL_FROM": "login@anydock.ai",
    // Artifacts' web pages and small apps run here, a different site from anydock.ai.
    "USERCONTENT_ORIGIN": "https://u.anydock.ai"
  },
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["login@anydock.ai"] }],
  "d1_databases": [
    { "binding": "DB", "database_name": "anydock-v2", "database_id": "ab0d9d1f-6abc-4109-bc6b-d8ef56ed832c", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "TRAJECTORIES", "bucket_name": "anydock-trajectories" }
  ],
  // One UserHub per user fans out live events to that user's sockets.
  // One ArtifactRoom per artifact: live edits and presence for everyone who has it open.
  // AppContainer: an app's backend in Cloudflare Containers (src/container.ts), from the public Node image — no build.
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "UserHub" }, { "name": "ROOM", "class_name": "ArtifactRoom" }, { "name": "APP_CONTAINER", "class_name": "AppContainer" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserHub"] }, { "tag": "v2", "new_sqlite_classes": ["ArtifactRoom"] }, { "tag": "v3", "new_sqlite_classes": ["AppContainer"] }],
  "containers": [{ "class_name": "AppContainer", "image": "docker.io/library/node:22-slim", "instance_type": "basic", "max_instances": 10 }],
  "routes": [{ "pattern": "anydock.ai", "custom_domain": true }, { "pattern": "u.anydock.ai", "custom_domain": true }],
  // Keep local dev on localhost; otherwise wrangler dev rewrites requests to the route's host and auth rejects them.
  // Containers need Docker locally; dev skips them (app backends are tested against a mock runtime).
  "dev": { "port": 8787, "host": "localhost:8787", "enable_containers": false },
  "observability": { "enabled": true }
  // Secrets (wrangler secret put / .dev.vars): BETTER_AUTH_SECRET, GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET,
  // GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, PRIMITIVE_API_KEY, EMAIL_FROM. See SETUP.md.
}
